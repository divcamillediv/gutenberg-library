# Copier ce fichier en .env pour personnaliser Docker Compose.

# Dossier de données du backend. Un chemin relatif est résolu depuis la racine du
# projet, pas depuis le dossier courant. Dans Docker, DATA_DIR vaut /data.
DATA_DIR=./data

# Ports exposés sur la machine serveur (Docker Compose)
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Origines autorisées par CORS (séparées par des virgules). "*" en développement.
CORS_ORIGINS=*

# Cible du proxy /api du serveur Vite (développement)
# VITE_PROXY_TARGET=http://127.0.0.1:8000
# Adresse absolue du backend pour le frontend (par défaut : appels relatifs /api)
# VITE_API_BASE_URL=
