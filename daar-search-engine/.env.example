# Copier ce fichier en .env pour personnaliser Docker Compose.

# Ports exposés sur la machine serveur
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Origines autorisées par CORS (séparées par des virgules). "*" en développement.
CORS_ORIGINS=*

# --- Développement sans Docker ---
# Dossier de données du backend (par défaut : ./data à la racine du dépôt)
# DATA_DIR=/chemin/vers/data
# Cible du proxy /api du serveur Vite (par défaut : http://localhost:8000)
# VITE_PROXY_TARGET=http://localhost:8000
# Adresse absolue du backend pour le frontend (par défaut : appels relatifs /api)
# VITE_API_BASE_URL=
